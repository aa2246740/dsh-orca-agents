{
  "name": "dsh-orca-agents",
  "version": "0.2.1",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-orca-agents.git"
  },
  "type": "module",
  "description": "Dispatch coding agents into the local Orca desktop from DSH chat.",
  "main": "./lib/dsh-orca-agents.js",
  "exports": {
    ".": "./lib/dsh-orca-agents.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test tests/*.spec.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-skill",
        "@deepseek-ai/dsh-tools"
      ]
    }
  },
  "devDependencies": {
    "semver": "^7.8.5",
    "tsdown": "^0.22.2"
  }
}
